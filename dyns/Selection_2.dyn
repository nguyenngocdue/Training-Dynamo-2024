      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"Copyright(c) 2019 by: duengocnguyen@gmail.com\"\"\"\r\nimport clr\r\nimport sys\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import Selection\r\nfrom  Autodesk.Revit.UI.Selection import ISelectionFilter\r\n\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import*\r\n\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('DSCoreNodes')\r\nfrom DSCore import *\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\n\r\nimport System.Drawing\r\nimport System.Windows.Forms\r\n\r\nfrom System.Drawing import *\r\nfrom System.Windows.Forms import *\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nUIunit = Document.GetUnits(doc).GetFormatOptions(UnitType.UT_Length).DisplayUnits\r\nclass MainForm(Form):\r\n\tdef __init__(self):\r\n\t\tself.InitializeComponent()\r\n\t\r\n\tdef InitializeComponent(self):\r\n\t\tself._groupBox1 = System.Windows.Forms.GroupBox()\r\n\t\tself._btnPickPoint = System.Windows.Forms.Button()\r\n\t\tself._btnOK = System.Windows.Forms.Button()\r\n\t\tself._btnCancel = System.Windows.Forms.Button()\r\n\t\tself._groupBox1.SuspendLayout()\r\n\t\tself.SuspendLayout()\r\n\t\t# \r\n\t\t# groupBox1\r\n\t\t# \r\n\t\tself._groupBox1.Controls.Add(self._btnPickPoint)\r\n\t\tself._groupBox1.Location = System.Drawing.Point(3, 1)\r\n\t\tself._groupBox1.Name = \"groupBox1\"\r\n\t\tself._groupBox1.Size = System.Drawing.Size(310, 69)\r\n\t\tself._groupBox1.TabIndex = 0\r\n\t\tself._groupBox1.TabStop = False\r\n\t\tself._groupBox1.Text = \"PickPoint Selection\"\r\n\t\t# \r\n\t\t# btnPickPoint\r\n\t\t# \r\n\t\tself._btnPickPoint.Location = System.Drawing.Point(93, 28)\r\n\t\tself._btnPickPoint.Name = \"btnPickPoint\"\r\n\t\tself._btnPickPoint.Size = System.Drawing.Size(130, 23)\r\n\t\tself._btnPickPoint.TabIndex = 0\r\n\t\tself._btnPickPoint.Text = \"Pick Point\"\r\n\t\tself._btnPickPoint.UseVisualStyleBackColor = True\r\n\t\tself._btnPickPoint.Click += self.BtnPickPointClick\r\n\t\t# \r\n\t\t# btnOK\r\n\t\t# \r\n\t\tself._btnOK.Location = System.Drawing.Point(58, 78)\r\n\t\tself._btnOK.Name = \"btnOK\"\r\n\t\tself._btnOK.Size = System.Drawing.Size(75, 23)\r\n\t\tself._btnOK.TabIndex = 1\r\n\t\tself._btnOK.Text = \"OK\"\r\n\t\tself._btnOK.UseVisualStyleBackColor = True\r\n\t\tself._btnOK.Click += self.BtnOKClick\r\n\t\t# \r\n\t\t# btnCancel\r\n\t\t# \r\n\t\tself._btnCancel.Location = System.Drawing.Point(193, 78)\r\n\t\tself._btnCancel.Name = \"btnCancel\"\r\n\t\tself._btnCancel.Size = System.Drawing.Size(75, 23)\r\n\t\tself._btnCancel.TabIndex = 2\r\n\t\tself._btnCancel.Text = \"Cancel\"\r\n\t\tself._btnCancel.UseVisualStyleBackColor = True\r\n\t\tself._btnCancel.Click += self.BtnCancelClick\r\n\t\t# \r\n\t\t# MainForm\r\n\t\t# \r\n\t\tself.BackColor = System.Drawing.SystemColors.ControlLightLight\r\n\t\tself.ClientSize = System.Drawing.Size(321, 109)\r\n\t\tself.Controls.Add(self._btnCancel)\r\n\t\tself.Controls.Add(self._btnOK)\r\n\t\tself.Controls.Add(self._groupBox1)\r\n\t\tself.MaximizeBox = False\r\n\t\tself.Name = \"MainForm\"\r\n\t\tself.ShowIcon = False\r\n\t\tself.SizeGripStyle = System.Windows.Forms.SizeGripStyle.Hide\r\n\t\tself.StartPosition = System.Windows.Forms.FormStartPosition.CenterParent\r\n\t\tself.Text = \"MethodSelections\"\r\n\t\tself.TopMost = True\r\n\t\tself._groupBox1.ResumeLayout(False)\r\n\t\tself.ResumeLayout(False)\r\n\t\tself.out = []\r\n\t\tself.point = []\r\n\tdef BtnPickPointClick(self, sender, e):\r\n\t\tpts = uidoc.Selection.PickPoint()\r\n\t\tself.point = XYZ(UnitUtils.ConvertToInternalUnits(pts.X,UIunit),\r\n\t\tUnitUtils.ConvertToInternalUnits(pts.Y,UIunit),\r\n\t\tUnitUtils.ConvertToInternalUnits(pts.Z,UIunit))\r\n\t\tpass\r\n\r\n\tdef BtnOKClick(self, sender, e):\r\n\t\tself.Close()\r\n\t\tpass\r\n\r\n\tdef BtnCancelClick(self, sender, e):\r\n\t\tself.point =[]\r\n\t\tself.Close()\r\n\t\tpass\r\nform = MainForm()\r\nApplication.Run(form)\r\nOUT = form.point",
