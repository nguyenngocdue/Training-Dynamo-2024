      "Code": "import clr\r\nimport msvcrt\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import*\r\n\r\ncheck = IN[0]\r\ncontent = IN[1]\r\n\r\nresult = str(IN[1])\r\n\r\nbutton = TaskDialogCommonButtons.None\r\n\r\nif check == True:\r\n    TaskDialog.Show('Result',result,button)\r\nelse:\r\n    result = \"Set True to run\"\r\nOUT = result",
