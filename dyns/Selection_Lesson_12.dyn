      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"Copyright(c) 2019 by: duengocnguyen@gmail.com\"\"\"\r\nimport clr\r\nclr.AddReference('System.Windows.Forms')\r\nclr.AddReference('System.Drawing')\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\nclr.AddReference(\"RevitServices\")\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nimport System.Drawing\r\nimport System.Windows.Forms\r\n\r\nfrom System.Drawing import *\r\nfrom System.Windows.Forms import *\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nview = doc.ActiveView\r\ncategories = doc.Settings.Categories\r\nModelCat =[]\r\nfor i in categories:\r\n\tif i.CategoryType == CategoryType.Model:\r\n\t\tModelCat.append(Revit.Elements.Category.ById(i.Id.IntegerValue))\r\n\r\nclass MainForm(Form):\r\n\tdef __init__(self):\r\n\t\tself.InitializeComponent()\r\n\t\r\n\tdef InitializeComponent(self):\r\n\t\tself._groupBox1 = System.Windows.Forms.GroupBox()\r\n\t\tself._label1 = System.Windows.Forms.Label()\r\n\t\tself._cbxType = System.Windows.Forms.ComboBox()\r\n\t\tself._button1 = System.Windows.Forms.Button()\r\n\t\tself._btnCancel = System.Windows.Forms.Button()\r\n\t\tself._checkAllNone = System.Windows.Forms.CheckBox()\r\n\t\tself._lstView = System.Windows.Forms.ListView()\r\n\t\tself._groupBox1.SuspendLayout()\r\n\t\tself.SuspendLayout()\r\n\t\t# \r\n\t\t# groupBox1\r\n\t\t# \r\n\t\tself._groupBox1.Controls.Add(self._cbxType)\r\n\t\tself._groupBox1.Controls.Add(self._label1)\r\n\t\tself._groupBox1.Location = System.Drawing.Point(4, -3)\r\n\t\tself._groupBox1.Name = \"groupBox1\"\r\n\t\tself._groupBox1.Size = System.Drawing.Size(348, 64)\r\n\t\tself._groupBox1.TabIndex = 0\r\n\t\tself._groupBox1.TabStop = False\r\n\t\t# \r\n\t\t# label1\r\n\t\t# \r\n\t\tself._label1.Location = System.Drawing.Point(6, 27)\r\n\t\tself._label1.Name = \"label1\"\r\n\t\tself._label1.Size = System.Drawing.Size(100, 23)\r\n\t\tself._label1.TabIndex = 1\r\n\t\tself._label1.Text = \"ComboBox:\"\r\n\t\t# \r\n\t\t# cbxType\r\n\t\t# \r\n\t\tself._cbxType.CausesValidation = False\r\n\t\tself._cbxType.FormattingEnabled = True\r\n\t\tself._cbxType.Location = System.Drawing.Point(70, 24)\r\n\t\tself._cbxType.Name = \"cbxType\"\r\n\t\tself._cbxType.Size = System.Drawing.Size(271, 21)\r\n\t\tself._cbxType.Sorted = True\r\n\t\tself._cbxType.TabIndex = 2\r\n\t\tself._cbxType.TabStop = False\r\n\t\tself._cbxType.Items.AddRange(System.Array[System.Object](ModelCat))\r\n\t\tself._cbxType.SelectedIndexChanged += self.CbxTypeSelectedIndexChanged\r\n\t\t# \r\n\t\t# button1\r\n\t\t# \r\n\t\tself._button1.Location = System.Drawing.Point(193, 340)\r\n\t\tself._button1.Name = \"button1\"\r\n\t\tself._button1.Size = System.Drawing.Size(75, 23)\r\n\t\tself._button1.TabIndex = 1\r\n\t\tself._button1.Text = \"OK\"\r\n\t\tself._button1.UseVisualStyleBackColor = True\r\n\t\tself._button1.Click += self.Button1Click\r\n\t\t# \r\n\t\t# btnCancel\r\n\t\t# \r\n\t\tself._btnCancel.Location = System.Drawing.Point(277, 340)\r\n\t\tself._btnCancel.Name = \"btnCancel\"\r\n\t\tself._btnCancel.Size = System.Drawing.Size(75, 23)\r\n\t\tself._btnCancel.TabIndex = 2\r\n\t\tself._btnCancel.Text = \"Cancel\"\r\n\t\tself._btnCancel.UseVisualStyleBackColor = True\r\n\t\tself._btnCancel.Click += self.BtnCancelClick\r\n\t\t# \r\n\t\t# checkAllNone\r\n\t\t# \r\n\t\tself._checkAllNone.Location = System.Drawing.Point(4, 298)\r\n\t\tself._checkAllNone.Name = \"checkAllNone\"\r\n\t\tself._checkAllNone.Size = System.Drawing.Size(104, 24)\r\n\t\tself._checkAllNone.TabIndex = 8\r\n\t\tself._checkAllNone.Text = \"Select All/None\"\r\n\t\tself._checkAllNone.UseVisualStyleBackColor = True\r\n\t\tself._checkAllNone.CheckedChanged += self.CheckAllNoneCheckedChanged\r\n\t\t# \r\n\t\t# lstView\r\n\t\t# \r\n\t\tself._lstView.AllowColumnReorder = True\r\n\t\tself._lstView.BorderStyle = System.Windows.Forms.BorderStyle.FixedSingle\r\n\t\tself._lstView.CheckBoxes = True\r\n\t\tself._lstView.Location = System.Drawing.Point(4, 68)\r\n\t\tself._lstView.Name = \"lstView\"\r\n\t\tself._lstView.Size = System.Drawing.Size(348, 222)\r\n\t\tself._lstView.Sorting = System.Windows.Forms.SortOrder.Ascending\r\n\t\tself._lstView.TabIndex = 9\r\n\t\tself._lstView.TabStop = False\r\n\t\tself._lstView.UseCompatibleStateImageBehavior = False\r\n\t\tself._lstView.View = System.Windows.Forms.View.List\r\n\t\t# \r\n\r\n\t\t# MainForm\r\n\t\t# \r\n\t\tself.AutoSizeMode = System.Windows.Forms.AutoSizeMode.GrowAndShrink\r\n\t\tself.BackColor = System.Drawing.SystemColors.ControlLightLight\r\n\t\tself.ClientSize = System.Drawing.Size(357, 373)\r\n\t\tself.Controls.Add(self._lstView)\r\n\t\tself.Controls.Add(self._checkAllNone)\r\n\t\tself.Controls.Add(self._btnCancel)\r\n\t\tself.Controls.Add(self._button1)\r\n\t\tself.Controls.Add(self._groupBox1)\r\n\t\tself.MaximizeBox = False\r\n\t\tself.Name = \"MainForm\"\r\n\t\tself.ShowIcon = False\r\n\t\tself.SizeGripStyle = System.Windows.Forms.SizeGripStyle.Hide\r\n\t\tself.StartPosition = System.Windows.Forms.FormStartPosition.CenterParent\r\n\t\tself.Text = \"Day03\"\r\n\t\tself._groupBox1.ResumeLayout(False)\r\n\t\tself.ResumeLayout(False)\r\n\t\tself.ElementFiltered=[]\r\n\t\t\r\n\tdef Button1Click(self, sender, e):\r\n\t\tself.Close()\r\n\t\tpass\r\n\r\n\tdef BtnCancelClick(self, sender, e):\r\n\t\tself.Close()\r\n\t\tpass\r\n\r\n\tdef CbxTypeSelectedIndexChanged(self, sender, e):\r\n\t\tself._lstView.Items.Clear()\r\n\t\tcatergoryFilter = []\r\n\t\tself.listBoxSelected = [self._cbxType.SelectedItem]\r\n\t\tfor i in self.listBoxSelected:\r\n\t\t\tcatergoryFilter.append(ElementCategoryFilter(System.Enum.ToObject(BuiltInCategory,int(str(i.Id)))))\r\n\t\tfilter = LogicalOrFilter(catergoryFilter)\r\n\t\tself.ElementFiltered = FilteredElementCollector(doc,view.Id).WherePasses(filter).ToElements()\r\n\t\tfor i in self.ElementFiltered:\r\n\t\t\tself._lstView.Items.Add(Element.Name.__get__(i))\r\n\t\tpass\r\n\r\n\tdef CheckAllNoneCheckedChanged(self, sender, e):\r\n\t\tif self._checkAllNone.Checked == True:\r\n\t\t\tfor i in self._lstView.Items:\t\t\t\r\n\t\t\t\ti.Checked = True\r\n\t\telse:\r\n\t\t\tfor i in self._lstView.Items:\t\t\t\r\n\t\t\t\ti.Checked = False\r\n\r\n\t\tpass\r\n\t\t\r\nf = MainForm()\r\nApplication.Run(f)\r\nOUT =f.ElementFiltered",
