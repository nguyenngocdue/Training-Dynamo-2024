      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\"\"\"Copyright(c) 2019 by: duengocnguyen@gmail.com\"\"\"\n\nimport clr\nimport sys\n\nclr.AddReference('RevitAPI')\nfrom Autodesk.Revit.DB import *\n\nclr.AddReference('RevitAPIUI')\nfrom Autodesk.Revit.UI import Selection\nfrom  Autodesk.Revit.UI.Selection import ISelectionFilter\n\nclr.AddReference('RevitNodes')\nimport Revit\nclr.ImportExtensions(Revit.Elements)\nclr.ImportExtensions(Revit.GeometryConversion)\n\nclr.AddReference('RevitServices')\nfrom RevitServices.Persistence import DocumentManager\n\nclr.AddReference('DSCoreNodes')\nfrom DSCore import *\ndoc = DocumentManager.Instance.CurrentDBDocument\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\n\n\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\nclr.AddReference('System.Windows.Forms.DataVisualization')\n\nimport System.Windows.Forms\nimport System.Drawing\n\nfrom System.Drawing import *\nfrom System.Windows.Forms import *\nfrom System.Collections.Generic import *\n\nclass selectionfilter(ISelectionFilter):\n\tdef __init__(self,category):\n\t\tself.category = category\n\tdef AllowElement(self,element):\n\t\tif element.Category.Name in [c.Name for c in self.category]:\n\t\t\treturn True\n\t\telse:\n\t\t\treturn False\n\tdef AllowReference(reference,point):\n\t\treturn False\n\t\nclass MainForm(Form):\n\tdef __init__(self):\n\t\tself.InitializeComponent()\n\t\n\tdef InitializeComponent(self):\n\n\t\tself.El =()\n\n\n\t\tself._selec = System.Windows.Forms.Button()\n\t\tself._button1 = System.Windows.Forms.Button()\n\t\tself._button2 = System.Windows.Forms.Button()\n\t\tself.SuspendLayout()\n\t\t# \n\t\t# selec\n\t\t# \n\t\tself._selec.Cursor = System.Windows.Forms.Cursors.Hand\n\t\tself._selec.Location = System.Drawing.Point(48, 12)\n\t\tself._selec.Name = \"selec\"\n\t\tself._selec.Size = System.Drawing.Size(173, 36)\n\t\tself._selec.TabIndex = 1\n\t\tself._selec.Text = \"Select Model Elements\"\n\t\tself._selec.UseVisualStyleBackColor = True\n\t\tself._selec.Click += self.sele\n\t\t# \n\t\t# button1\n\t\t# \n\t\tself._button1.Cursor = System.Windows.Forms.Cursors.Hand\n\t\tself._button1.Location = System.Drawing.Point(32, 71)\n\t\tself._button1.Name = \"button1\"\n\t\tself._button1.Size = System.Drawing.Size(73, 23)\n\t\tself._button1.TabIndex = 2\n\t\tself._button1.Text = \"OK\"\n\t\tself._button1.UseVisualStyleBackColor = True\n\t\tself._button1.Click += self.ok\n\t\t# \n\t\t# button2\n\t\t# \n\t\tself._button2.Cursor = System.Windows.Forms.Cursors.Hand\n\t\tself._button2.Location = System.Drawing.Point(164, 71)\n\t\tself._button2.Name = \"button2\"\n\t\tself._button2.Size = System.Drawing.Size(73, 23)\n\t\tself._button2.TabIndex = 3\n\t\tself._button2.Text = \"Cancel\"\n\t\tself._button2.UseVisualStyleBackColor = True\n\t\tself._button2.Click += self.close\n\t\t# \n\t\t# MainForm\n\t\t# \n\t\tself.AutoScaleDimensions = System.Drawing.SizeF(6, 13)\n\t\tself.AutoScaleMode = System.Windows.Forms.AutoScaleMode.Font\n\t\tself.AutoSizeMode = System.Windows.Forms.AutoSizeMode.GrowAndShrink\n\t\tself.AutoValidate = System.Windows.Forms.AutoValidate.EnablePreventFocusChange\n\t\tself.CausesValidation = False\n\t\tself.ClientSize = System.Drawing.Size(275, 106)\n\t\tself.Controls.Add(self._button2)\n\t\tself.Controls.Add(self._button1)\n\t\tself.Controls.Add(self._selec)\n\t\tself.MaximizeBox = False\n\t\tself.MinimizeBox = False\n\t\tself.Name = \"MainForm\"\n\t\tself.ShowIcon = False\n\t\tself.StartPosition = System.Windows.Forms.FormStartPosition.CenterScreen\n\t\tself.Text = \"Select Elements\"\n\t\tself.TopMost = True\n\t\tself.ResumeLayout(False)\n\n\tdef close(self, sender, e):\n\t\tself.Ele=[]\n\t\tself.Close()\n\tdef sele(self, sender,e):\n\t\ttry:\n\t\t\tcategory = [UnwrapElement(IN[1])]\n\t\t\tselfilt = selectionfilter(category)\n\t\t\tself.El = uidoc.Selection.PickObjects(Selection.ObjectType.Element,selfilt,'abs')\n\t\t\tself.selelem = (doc.GetElement(i.ElementId) for i in self.El)\n\t\t\tself.Ele = (i.ToDSType(True\t) for i in self.selelem )\n\t\texcept:\n\t\t\t\tpass\n\n\tdef ok(self,sender, e):\n\t\tself.Close()\n\n\nf = MainForm()\nApplication.Run(f)\n\nOUT = f.Ele\n\n",
