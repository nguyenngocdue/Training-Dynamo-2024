      "Code": "_dict = IN[1]\r\n\r\n\r\nkeys , values = [], []\r\n\r\nfor key, value in _dict.items():\r\n    keys.append(key)\r\n    values.append(value)\r\nOUT = {'keys' :keys , 'values' : values} #Order By\r\n    ",
