    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "_dict = IN[1]\r\n_keyIndexs = IN[2]\r\n_valueIndexs = IN[3]\r\n\r\nfor key, value in _dict.items():\r\n    for keyIndex, valueIndex in zip(_keyIndexs, _valueIndexs):\r\n        if str(key) == str(keyIndex):\r\n            _dict[key] = valueIndex\r\n            \r\nOUT = _dict",
